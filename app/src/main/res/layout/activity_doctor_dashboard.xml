<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_standard"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Premium Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:cardBackgroundColor="@color/glass_white"
            app:cardCornerRadius="32dp"
            app:cardElevation="12dp"
            app:strokeColor="@color/white"
            app:strokeWidth="1.5dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp">

                <View
                    android:id="@+id/doc_avatar_bg"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_streak_fire"
                    android:backgroundTint="#E3F2FD"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/doc_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👨‍⚕️"
                    android:textSize="30sp"
                    app:layout_constraintBottom_toBottomOf="@id/doc_avatar_bg"
                    app:layout_constraintEnd_toEndOf="@id/doc_avatar_bg"
                    app:layout_constraintStart_toStartOf="@id/doc_avatar_bg"
                    app:layout_constraintTop_toTopOf="@id/doc_avatar_bg" />

                <TextView
                    android:id="@+id/doctor_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:text="@string/doctor_welcome"
                    android:textColor="#1A237E"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@+id/logout_btn"
                    app:layout_constraintStart_toEndOf="@id/doc_avatar_bg"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/doctor_id_display"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:background="@drawable/bg_streak_fire"
                    android:backgroundTint="#E1F5FE"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="ID: 1176"
                    android:textColor="#0288D1"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/doc_avatar_bg"
                    app:layout_constraintTop_toBottomOf="@id/doctor_name" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Profile"
                    android:textAllCaps="false"
                    android:textColor="#3F51B5"
                    app:icon="@android:drawable/ic_menu_edit"
                    app:iconTint="#3F51B5"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <ImageButton
                    android:id="@+id/logout_btn"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_lock_power_off"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="#D32F2F" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Section Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            android:text="Practice Overview"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Modern Stats Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:columnCount="2"
            android:rowCount="2">

            <!-- Total Patients -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/total_patients_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PATIENTS" android:textColor="#9E9E9E" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/total_patients_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="24" android:textColor="#1976D2" android:textSize="28sp" android:textStyle="bold" />
                    <View android:layout_width="30dp" android:layout_height="3dp" android:layout_marginTop="4dp" android:background="#1976D2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's Visits -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/appointments_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="VISITS" android:textColor="#9E9E9E" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/todays_appts_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08" android:textColor="#00796B" android:textSize="28sp" android:textStyle="bold" />
                    <View android:layout_width="30dp" android:layout_height="3dp" android:layout_marginTop="4dp" android:background="#00796B" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pending Approvals -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pending_approvals_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PENDING" android:textColor="#9E9E9E" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/pending_approvals_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03" android:textColor="#F57C00" android:textSize="28sp" android:textStyle="bold" />
                    <View android:layout_width="30dp" android:layout_height="3dp" android:layout_marginTop="4dp" android:background="#F57C00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Brushing Reviews -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/pending_reviews_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="6dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="24dp"
                app:cardElevation="6dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="REVIEWS" android:textColor="#9E9E9E" android:textSize="10sp" android:textStyle="bold" />
                    <TextView android:id="@+id/pending_reviews_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" android:textColor="#7B1FA2" android:textSize="28sp" android:textStyle="bold" />
                    <View android:layout_width="30dp" android:layout_height="3dp" android:layout_marginTop="4dp" android:background="#7B1FA2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </GridLayout>

        <!-- Quick Actions Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_appointments_feature"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="Schedule"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_my_calendar"
                android:backgroundTint="#00897B"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_all_patients"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="My Patients"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@android:drawable/ic_menu_myplaces"
                android:backgroundTint="#3949AB"/>
        </LinearLayout>

        <!-- Today's List Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="32dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today's Schedule"
                    android:textColor="#1A237E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/appointments_mini_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:minHeight="100dp" />

                <TextView
                    android:id="@+id/empty_schedule_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No appointments for today"
                    android:textColor="#BDBDBD"
                    android:gravity="center"
                    android:layout_margin="20dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Spacer for Scroll -->
        <View android:layout_width="match_parent" android:layout_height="40dp" />

    </LinearLayout>
</ScrollView>
